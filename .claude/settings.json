{
  "permissions": {
    "allow": [
      "Bash(uv sync*)",
      "Bash(uv run ruff*)",
      "Bash(uv run pytest*)",
      "Bash(uv run skillz*)",
      "Bash(uv build*)",
      "Bash(git -C *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push * main*)",
      "Bash(git push * master*)",
      "Bash(git * push --force*)",
      "Bash(git * push -f*)",
      "Bash(git * push * --force*)",
      "Bash(git * push * -f*)",
      "Bash(git * push * +*)",
      "Bash(git * push * main*)",
      "Bash(git * push * master*)",
      "Bash(git reset --hard*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git * reset --hard*)",
      "Bash(git * filter-branch*)",
      "Bash(git * filter-repo*)",
      "Bash(git branch -D*)",
      "Bash(git * branch -D*)",
      "Bash(git checkout -- *)",
      "Bash(git * checkout -- *)",
      "PowerShell(*)",
      "Bash(git --git-dir*)",
      "Bash(git -c *)",
      "Bash(gh pr merge*)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(pip install*)",
      "Bash(pip3 install*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.env.prod)",
      "Read(**/.env.dev)",
      "Read(**/.env.ci)",
      "Read(**/.env.backup)",
      "Read(**/.env.bak)",
      "Read(**/.env.*.local)",
      "Read(**/.envrc)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.production)",
      "Edit(**/.env.development)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)",
      "Edit(**/.env.prod)",
      "Edit(**/.env.dev)",
      "Edit(**/.env.ci)",
      "Edit(**/.env.backup)",
      "Edit(**/.env.bak)",
      "Edit(**/.env.*.local)",
      "Edit(**/.envrc)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Write(**/.env.production)",
      "Write(**/.env.development)",
      "Write(**/.env.staging)",
      "Write(**/.env.test)",
      "Write(**/.env.prod)",
      "Write(**/.env.dev)",
      "Write(**/.env.ci)",
      "Write(**/.env.backup)",
      "Write(**/.env.bak)",
      "Write(**/.env.*.local)",
      "Write(**/.envrc)"
    ]
  },
  "attribution": {
    "sessionUrl": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "*.pythonhosted.org"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|MultiEdit|Write|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
